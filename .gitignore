# 依赖（本项目零运行时依赖，通常不存在）
node_modules/

# 环境变量与密钥
.env
.env.local

# 运行时数据（存档）
data/
*.save.json

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# 桌面版打包产物（体积大、可重新生成，不进仓库）
desktop/.wheels/
desktop/.pylibs/
desktop/dist/
desktop/release/
desktop/build/work/
desktop/build/*.spec
desktop/build/pyinstaller.log
desktop/app.ico
desktop/.icon-preview-*.png

# download/ 里的成品压缩包是**故意**提交的：
# 它给不装任何东西的人一条点击即下的链接。要换新版本时覆盖同名文件即可。
!download/*.zip

# ima 知识库索引缓存（下载下来的书 + 抽出的正文，可随时删）
.ima-cache/
python/.ima-cache/

# Python 字节码
__pycache__/
*.pyc

# 本地临时产物（测试用的样本、假 CLI、调试脚本等）
.tmp/
