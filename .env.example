# ═══════════════════════════════════════════════════════════════════
#  学术galgame Agent · 环境变量模板
#  用法：把本文件复制为 .env （Copy-Item .env.example .env），再填入下面的值
#  ⚠️ .env 已被 .gitignore 忽略，绝不会进入 Git 仓库；请勿把真实 Key 写进任何 .js 文件
# ═══════════════════════════════════════════════════════════════════

# ── 大模型接口 ※必填，没有则自动进入 DEMO 模式 ────────────────────
#
# 不绑定任何一家供应商：只要接口是「OpenAI 兼容」
# （POST {LLM_BASE_URL}/chat/completions + Bearer 鉴权）就能用。
#
# 【例一】DeepSeek（最省事）
#   LLM_API_KEY=<你的 DeepSeek Key>
#   LLM_MODEL=deepseek-chat
#   LLM_BASE_URL=https://api.deepseek.com
#
# 【例二】火山引擎 · 火山方舟（Ark）
#   1. 登录控制台 https://console.volcengine.com/ark
#      （需先完成「实名认证」，否则无法开通方舟）
#   2. 左侧「API Key 管理」→ 创建 API Key → 复制 → 填到 LLM_API_KEY
#      ⚠️ 只在创建时完整显示一次，请立刻保存
#   3. 左侧「在线推理」→ 创建推理接入点 → 选一个模型 → 创建
#      完成后会得到一个 ep- 开头的接入点 ID → 填到 LLM_MODEL
#      （若提示模型未开通，先去左侧「开通管理」开通该模型）
#   4. 若只用方舟，LLM_BASE_URL 可留空（默认值即方舟）
#
# 填好后自检：npm run check:llm      通过后再 npm start
#
LLM_API_KEY=
LLM_MODEL=
# 留空 = 默认火山方舟（北京区）；用其它服务请填它的 Base URL，例如 https://api.deepseek.com
LLM_BASE_URL=

# 兼容别名：早期版本用的 ARK_* 仍然生效，但新配置请优先用上面的 LLM_*
# ARK_API_KEY=
# ARK_MODEL=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── 本地服务 ────────────────────────────────────────────────────────
# 浏览器访问 http://127.0.0.1:8787 ；端口被占用时改 PORT
PORT=8787
HOST=127.0.0.1

# ── 可选：教材语料目录 ──────────────────────────────────────────────
# 老师出题/讲解的「真实依据」来源。默认读取项目下的 corpus/
# GALGAME_CORPUS=./corpus

# ── 可选：存档路径 ──────────────────────────────────────────────────
# 默认写到项目下的 data/save.json（已 gitignore）
# GALGAME_SAVE=./data/save.json

# ── 可选：改用 ima 知识库做检索（不填则使用上面的本地语料）─────────
# 若你已有腾讯 ima 知识库，可用它替代本地语料：
#   IMA_API_KEY   / IMA_CLIENT_ID —— ima 开放接口凭证
#   IMA_KB        —— 默认知识库 ID
#   IMA_KB_MAP    —— 按学科指定不同知识库，JSON 格式
# IMA_API_KEY=
# IMA_CLIENT_ID=
# IMA_KB=
# IMA_KB_MAP={"博弈论":"xxxx","社会科学":"yyyy"}
