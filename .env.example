# ═══════════════════════════════════════════════════════════════════
#  学术galgame Agent · 环境变量模板
#  用法：把本文件复制为 .env （Copy-Item .env.example .env），再填入下面的值
#  ⚠️ .env 已被 .gitignore 忽略，绝不会进入 Git 仓库；请勿把真实 Key 写进任何 .js 文件
# ═══════════════════════════════════════════════════════════════════

# ── 大模型接口 ※必填，没有则自动进入 DEMO 模式 ────────────────────
#
# 不绑定任何一家供应商：只要接口是「OpenAI 兼容」
# （POST {LLM_BASE_URL}/chat/completions + Bearer 鉴权）就能用。
#
# 【例一】DeepSeek（最省事）
#   LLM_API_KEY=<你的 DeepSeek Key>
#   LLM_MODEL=deepseek-chat
#   LLM_BASE_URL=https://api.deepseek.com
#
# 【例二】火山引擎 · 火山方舟（Ark）
#   1. 登录控制台 https://console.volcengine.com/ark
#      （需先完成「实名认证」，否则无法开通方舟）
#   2. 左侧「API Key 管理」→ 创建 API Key → 复制 → 填到 LLM_API_KEY
#      ⚠️ 只在创建时完整显示一次，请立刻保存
#   3. 左侧「在线推理」→ 创建推理接入点 → 选一个模型 → 创建
#      完成后会得到一个 ep- 开头的接入点 ID → 填到 LLM_MODEL
#      （若提示模型未开通，先去左侧「开通管理」开通该模型）
#   4. LLM_BASE_URL 可留空 —— 会按模型名自动识别服务商
#
# 填好后自检：npm run check:llm      通过后再 npm start
#
LLM_API_KEY=
LLM_MODEL=
# 留空 = 按模型名自动识别服务商（deepseek-chat → DeepSeek，ep-… → 火山方舟）；
# 认不出来会明确报错。也可以直接填，例如 https://api.deepseek.com
LLM_BASE_URL=

# 兼容别名：早期版本用的 ARK_* 仍然生效，但新配置请优先用上面的 LLM_*
# ARK_API_KEY=
# ARK_MODEL=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── 本地服务 ────────────────────────────────────────────────────────
# 浏览器访问 http://127.0.0.1:8787 ；端口被占用时改 PORT
PORT=8787
HOST=127.0.0.1

# ── 可选：教材语料目录 ──────────────────────────────────────────────
# 老师出题/讲解的「真实依据」来源。默认读取项目下的 corpus/
# GALGAME_CORPUS=./corpus

# ── 可选：存档路径 ──────────────────────────────────────────────────
# 默认写到项目下的 data/save.json（已 gitignore）
# GALGAME_SAVE=./data/save.json

# ── 可选：改用 ima 知识库做检索（不填则使用上面的本地语料）─────────
# 若你已有腾讯 ima 知识库，可用它替代本地语料：
#   IMA_API_KEY   / IMA_CLIENT_ID —— ima 开放接口凭证
#   IMA_KB        —— 默认知识库 ID
#   IMA_KB_MAP    —— 按学科指定不同知识库，JSON 格式
# IMA_API_KEY=
# IMA_CLIENT_ID=
# IMA_KB=
# IMA_KB_MAP={"博弈论":"xxxx","社会科学":"yyyy"}


# ── 可选：让「有眼睛的模型」读扫描版 PDF ─────────────────────────────
#
# 扫描件整页都是图片、没有文字层，内置解析器一个字都抽不出来。
# 这时可以把页面渲染成图，交给**多模态模型**念出来 —— 不用下任何模型，一页一两秒。
#
# ⚠️ 走远程 API 时，**页面图片会被发到模型厂商**。想一个字都不外传就用本地模型。
#
# 【例一】用 DeepSeek 的多模态模型（省事）
#   GALGAME_VISION_BASE=https://api.deepseek.com/v1
#   GALGAME_VISION_MODEL=deepseek-chat
#   GALGAME_VISION_KEY=<你的 DeepSeek Key>
#
# 【例二】用本机 Ollama（不出本机、不花钱）—— 详见 README「用本地模型跑基础解析」
#   先装 Ollama，再 ollama pull qwen3.5:4b，然后：
#   GALGAME_VISION_BASE=http://127.0.0.1:11434/v1
#   GALGAME_VISION_MODEL=qwen3.5:4b
#   GALGAME_VISION_KEY=ollama        # 本地不需要鉴权，但建议填个非空值
#
# GALGAME_VISION=auto      # auto（默认，读不出来才用）/ always（直接上视觉）/ off（关闭）
# GALGAME_VISION_DPI=150   # 页面渲染清晰度，调高更准但更慢更贵
# GALGAME_VISION_MAX_PAGES=40
# GALGAME_VISION_TIMEOUT=180


# ── 可选：MinerU 本地 OCR（另一条读扫描件的路）─────────────────────
# 全本地离线，但要装 ≈818 MB 模型、慢一些。详见 README「扫描版 PDF」。
# GALGAME_MINERU=auto       # auto / always / off
# GALGAME_MINERU_TIER=basic # flash / basic / standard / advanced
# MINERU_CMD=               # MinerU 不在 PATH 里时显式指定路径
