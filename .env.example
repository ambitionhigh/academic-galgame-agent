# ── 火山引擎 · 火山方舟（Ark）──── 必填 ──────────────────────────────
# 控制台：https://console.volcengine.com/ark
ARK_API_KEY=
# 推理接入点 ID（ep-xxxxxxxx）或模型名；在方舟「在线推理」里创建接入点后获取
ARK_MODEL=
# 可选，默认即北京区 OpenAI 兼容地址
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── 服务 ────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1

# ── 可选：存档与教材语料路径 ────────────────────────────────────────
# GALGAME_SAVE=./data/save.json
# GALGAME_CORPUS=./corpus

# ── 可选：用 ima 知识库替代本地语料做检索 ──────────────────────────
# IMA_API_KEY=
# IMA_CLIENT_ID=
# IMA_KB=
# IMA_KB_MAP={"博弈论":"xxxx","社会科学":"yyyy"}
